# =============================================================================
# OllamaMax .gitignore
# Go backend + Vanilla JS frontend
# =============================================================================

# -------------------------
# Compiled / Build Outputs
# -------------------------
ollamamax
ollamamax-*
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.test
*.a
*.o
*.obj

# Go build cache
/vendor/

# -------------------------
# Backup Files
# -------------------------
*.bak
*.bak.*
*~
*.orig
*.rej
*.swp
*.swo

# -------------------------
# Go Specific
# -------------------------
# Test binary
*.test

# Go coverage output
*.coverprofile
coverage.out
coverage.html

# Go workspace file (if not committed intentionally)
# go.work
# go.work.sum

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/
config.local.*

# -------------------------
# Logs & Runtime
# -------------------------
*.log
logs/
*.pid

# -------------------------
# OS Generated
# -------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# -------------------------
# Editor / IDE
# -------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.vim/
*.swp
*.swo

# -------------------------
# Ollama / Model Data
# -------------------------
# Ignore locally pulled model weights if stored in project dir
models/
*.bin
*.gguf
*.ggml
*.pt
*.safetensors

# -------------------------
# Temp / Misc
# -------------------------
tmp/
temp/
.cache/
*.tmp
